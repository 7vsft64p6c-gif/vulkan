# =====================================================================
# VULKÁN — variables de entorno
# Copia este archivo como ".env" y complétalo. NUNCA subas el .env real
# a git ni lo pongas dentro de public_html.
# =====================================================================

APP_ENV=production
# 'development' habilita el selector de pago mock (Fase 30) y muestra
# detalle de errores. En tu hosting real, deja esto en "production".

APP_BASE_URL=https://tudominio.com
# Debe ser la URL pública real — Mercado Pago la usa para las back_urls
# y para el webhook (notification_url).

# ---------------------------------------------------------------------
# Proveedor de pagos
# ---------------------------------------------------------------------
PAYMENT_PROVIDER=mock
# 'mock' | 'mercadopago'

MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_ENVIRONMENT=sandbox
# 'sandbox' | 'production'
MERCADOPAGO_WEBHOOK_SECRET=
# La "clave secreta" que Mercado Pago te da al configurar el webhook
# (Tus integraciones > Webhooks > Configurar notificaciones).

# ---------------------------------------------------------------------
# Base de datos (cPanel > MySQL Databases)
# ---------------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=localhost
DB_NAME=cpaneluser_vulkan
DB_USER=cpaneluser_vulkan
DB_PASS=

# ---------------------------------------------------------------------
# Envío
# ---------------------------------------------------------------------
SHIPPING_AREQUIPA_CENTS=0
SHIPPING_PROVINCIA_CENTS=1500
# En céntimos. 1500 = S/15.00. Ajusta a tu tarifa real con Shalom.

# ---------------------------------------------------------------------
# Tienda
# ---------------------------------------------------------------------
STORE_NAME=VULKÁN
STORE_CONTACT_EMAIL=stevebunnies62@gmail.com

# Token simple para proteger endpoints administrativos futuros
# (reembolsos, panel de pedidos). Genera algo largo y aleatorio.
ADMIN_TOKEN=

# Si tu frontend se sirve desde un dominio distinto al backend, defínelo
# aquí EXACTO (con https://) para habilitar CORS. Si es el mismo
# dominio, déjalo vacío.
FRONTEND_ORIGIN=
